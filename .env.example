# =====================================================================
# MOKHALASA — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# =====================================================================
# Fill in your actual project values in a local .env file.
# NEVER commit your actual .env file or sensitive keys to Git.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
